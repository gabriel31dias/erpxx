# Copie para .env e ajuste. Em produção, troque o JWT_SECRET.
DATABASE_URL="file:../data/app.db"
JWT_SECRET="troque-este-segredo-em-producao"
PORT=3000
NODE_ENV=development

# URL pública do app: usada no retorno do checkout e no webhook.
APP_URL="https://localhost:3000"

# ---------- Planos ----------
# LIMITS = usuários,filiais,PDVs,produtos (-1 = ilimitado)
# FEATURES = relatorios.basico,relatorios.completo,export,multi.filial,importacao,crediario,suporte.prioritario
PLAN_BASICO_NAME="Básico"
PLAN_BASICO_PRICE="79,00"
PLAN_BASICO_LIMITS="3,1,1,500"
PLAN_BASICO_FEATURES="relatorios.basico"

PLAN_PRO_NAME="Profissional"
PLAN_PRO_PRICE="159,00"
PLAN_PRO_LIMITS="10,2,3,5000"
PLAN_PRO_FEATURES="relatorios.basico,relatorios.completo,export,importacao,crediario"

PLAN_PREMIUM_NAME="Premium"
PLAN_PREMIUM_PRICE="299,00"
PLAN_PREMIUM_LIMITS="-1,-1,-1,-1"
PLAN_PREMIUM_FEATURES="relatorios.basico,relatorios.completo,export,importacao,crediario,multi.filial,suporte.prioritario"

# Dias de teste grátis ao criar a conta
TRIAL_DAYS=14
